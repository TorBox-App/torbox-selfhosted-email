{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["@shadcn/lint"],
  "categories": {
    "correctness": "off"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "**/opengraph-image.tsx",
    "**/twitter-image.tsx",
    "apps/web/src/app/global-error.tsx"
  ],
  "settings": {
    "shadcn": {
      "ui": ["@wraps/ui/components/ui", "@/components/ui"],
      "note": "Design tokens and rules: see the design-context skill."
    }
  },
  "rules": {
    "shadcn/no-restyle": [
      "warn",
      {
        "allow": ["layout", "gap-*"],
        "contracts": [
          {
            "pattern": "(Content|Header|Footer)$",
            "allow": ["layout", "gap-*", "spacing"]
          },
          {
            "pattern": "(Title|Description)$",
            "allow": ["layout", "gap-*", "typography"]
          },
          {
            "pattern": "^Card$",
            "allow": [
              "layout",
              "gap-*",
              "spacing",
              "bg-*",
              "border-*",
              "shadow-*",
              "transition-*"
            ]
          },
          {
            "pattern": "^CardContent$",
            "allow": [
              "layout",
              "gap-*",
              "spacing",
              "typography",
              "text-muted-foreground"
            ]
          },
          {
            "pattern": "^(Label|FieldLabel)$",
            "allow": ["layout", "gap-*", "typography", "color"]
          },
          {
            "pattern": "^(TableCell|TableHead|TableRow)$",
            "allow": ["layout", "gap-*", "typography", "color"]
          },
          {
            "pattern": "^(Input|Textarea|InputGroupInput)$",
            "allow": ["layout", "gap-*", "spacing", "typography"]
          },
          { "pattern": "^Avatar$", "allow": ["layout", "rounded-*"] },
          {
            "pattern": "^AvatarFallback$",
            "allow": ["layout", "rounded-*", "typography", "color"]
          },
          {
            "pattern": "^Empty$",
            "allow": ["layout", "gap-*", "border", "border-*"]
          },
          { "pattern": "^AnimatedSpan$", "allow": ["layout", "color"] },
          {
            "pattern": "^Badge$",
            "allow": ["layout", "gap-*", "font-mono", "rounded-full"]
          },
          { "pattern": "^Button$", "allow": ["layout", "gap-*"] }
        ]
      }
    ],
    "shadcn/no-raw-colors": "warn",
    "shadcn/no-arbitrary-values": [
      "warn",
      { "allow": ["layout", "text-[0.85em]"] }
    ],
    "shadcn/no-inline-styles": [
      "warn",
      { "allow": ["transform", "animationDelay", "transitionDelay"] }
    ],
    "shadcn/require-static-classes": "warn"
  },
  "overrides": [
    {
      "files": [
        "packages/ui/src/components/ui/**",
        "apps/web/src/components/ui/**",
        "apps/website/src/components/ui/**",
        "packages/console/src/components/ui/**"
      ],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/require-static-classes": "off"
      }
    },
    {
      "files": ["apps/website/src/components/ui/svgs/**"],
      "rules": {
        "shadcn/no-raw-colors": "off"
      }
    }
  ]
}
