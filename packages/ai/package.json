{
  "name": "@wraps/ai",
  "version": "0.1.0",
  "private": true,
  "description": "Pluggable AI inference providers for Wraps. Selects a provider from deployment env and maps portable model requests onto provider-native call options.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "3.0.108",
    "@ai-sdk/anthropic": "2.0.88",
    "@ai-sdk/gateway": "2.0.18",
    "@ai-sdk/openai": "2.0.114",
    "@ai-sdk/provider-utils": "3.0.18",
    "@aws-sdk/credential-providers": "catalog:"
  },
  "devDependencies": {
    "ai": "5.0.108",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "ai": "5.0.108",
    "typescript": "catalog:"
  }
}
